<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/report_prompt"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/incident_description_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/incident_description_input"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="120dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/report_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/report_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/structure_report_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/structure_report" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fake_ai_notice"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

</ScrollView>
