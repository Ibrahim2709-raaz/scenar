<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scenar_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/profile_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/scenar_background"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/emergency_profile_title"
            app:titleTextColor="@color/scenar_text_primary" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_description"
                    android:textColor="@color/scenar_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/profile_completion_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/scenar_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/profile_completion_bar"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    app:indicatorColor="@color/scenar_teal"
                    app:trackColor="@color/scenar_teal_light"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/profile_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/scenar_emergency"
                    android:textSize="13sp" />

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/personal_details_title" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/preferred_name_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/preferred_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="100" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/date_of_birth_layout"
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/date_of_birth_label"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date_of_birth_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="@string/date_format_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/blood_type_label">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/blood_type_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/medical_information_title" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/allergies_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/allergies_input"
                        style="@style/ProfileMultilineInput"
                        android:hint="@string/none_known_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/medications_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/medications_input"
                        style="@style/ProfileMultilineInput"
                        android:hint="@string/none_known_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/medical_conditions_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/medical_conditions_input"
                        style="@style/ProfileMultilineInput"
                        android:hint="@string/none_known_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/accessibility_title" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/accessibility_needs_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/accessibility_needs_input"
                        style="@style/ProfileMultilineInput"
                        android:hint="@string/accessibility_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/emergency_contact_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/emergency_contact_description"
                    android:textColor="@color/scenar_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/contact_name_layout"
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/contact_name_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/contact_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="100" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/contact_relationship_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/contact_relationship_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="60" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/contact_phone_layout"
                    style="@style/ProfileTextInputLayout"
                    android:hint="@string/contact_phone_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/contact_phone_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="30" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_profile_button"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/save_profile"
                    android:textStyle="bold"
                    app:backgroundTint="@color/scenar_blue"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clear_profile_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/clear_profile_action"
                    android:textColor="@color/scenar_emergency" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>