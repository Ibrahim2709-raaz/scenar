<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>

    <!--
        The profile is encrypted with a device-bound Android Keystore
        key. Do not back up ciphertext that cannot be decrypted on a
        different device.
    -->
    <exclude
        domain="sharedpref"
        path="scenar_secure_profile.xml" />

</full-backup-content>