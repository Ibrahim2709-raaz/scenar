<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.SCENAR" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/scenar_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/scenar_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/scenar_navy</item>

        <item name="colorSecondary">@color/scenar_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/scenar_teal_light</item>
        <item name="colorOnSecondaryContainer">@color/scenar_navy</item>

        <item name="colorSurface">@color/scenar_surface</item>
        <item name="colorOnSurface">@color/scenar_text_primary</item>
        <item name="colorSurfaceVariant">@color/scenar_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/scenar_text_secondary</item>
        <item name="colorOutline">@color/scenar_border</item>

        <item name="colorError">@color/scenar_emergency</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:colorBackground">@color/scenar_background</item>
        <item name="android:windowBackground">@color/scenar_background</item>
        <item name="android:statusBarColor">@color/scenar_background</item>
        <item name="android:navigationBarColor">@color/scenar_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.SCENAR" parent="Base.Theme.SCENAR" />
    <style
        name="Theme.SCENAR.Starting"
        parent="Theme.SplashScreen.IconBackground">

        <item name="windowSplashScreenBackground">@color/scenar_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/scenar_blue</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/Theme.SCENAR</item>

    </style>

    <style
        name="ProfileSectionTitle"
        parent="TextAppearance.Material3.TitleMedium">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/scenar_text_primary</item>
        <item name="android:textStyle">bold</item>

    </style>

    <style
        name="ProfileTextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>

    </style>

    <style name="ProfileMultilineInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textCapSentences|textMultiLine</item>
        <item name="android:maxLines">5</item>
        <item name="android:minLines">2</item>
        <item name="android:maxLength">500</item>
    </style>

</resources>